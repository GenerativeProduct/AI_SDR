# AI SDR Platform — Environment Configuration
# Copy to .env and adjust for your environment

# --- Auth ---
SDR_AUTH_ENABLED=true
SDR_JWT_SECRET=change-me-to-a-long-random-secret
SDR_JWT_EXPIRE_MINUTES=60
SDR_REFRESH_EXPIRE_DAYS=7
SDR_DEFAULT_ADMIN_EMAIL=admin@sdr.local
SDR_DEFAULT_ADMIN_PASSWORD=admin123
SDR_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5180

# --- Database URLs (optional; defaults to ai_sdr_platform/data/*.db) ---
# SDR_AUTH_DATABASE_URL=
# SDR_ICP_DATABASE_URL=
# SDR_DISCOVERY_DATABASE_URL=
# SDR_ENRICHMENT_DATABASE_URL=
# SDR_INTELLIGENCE_DATABASE_URL=
# SDR_QUALIFICATION_DATABASE_URL=
# SDR_OUTREACH_DATABASE_URL=
# SDR_CONVERSATION_DATABASE_URL=
# SDR_FOLLOW_UP_DATABASE_URL=
# SDR_MEETING_DATABASE_URL=
# SDR_CRM_DATABASE_URL=
# SDR_JOBS_DATABASE_URL=

# --- Discovery ---
SDR_DISCOVERY_PROVIDER=public
SDR_DISCOVERY_ENABLE_WEB_SEARCH=true
# Synthetic contacts are FABRICATED personas (source: synthetic_persona) used only
# when no real contact source is configured. Set an Apollo key below for real people.
SDR_DISCOVERY_SYNTHETIC_CONTACTS=true

# --- Apollo contact discovery (real named people) ---
# When this key is set, the Apollo provider replaces synthetic/web-search contacts.
# SDR_DISCOVERY_APOLLO_API_KEY=
SDR_DISCOVERY_APOLLO_CONTACTS_PER_ACCOUNT=5
# Apollo's search endpoint never returns emails; revealing them requires a second
# enrichment call that consumes Apollo credits. Set false to skip it (no emails).
SDR_DISCOVERY_APOLLO_REVEAL_EMAILS=true

# --- Enrichment ---
SDR_ENRICHMENT_COLLECTION=sdr_enrichment
SDR_ENRICHMENT_LLM_PROVIDER=ollama_local
SDR_ENRICHMENT_LLM_MODEL=llama3.2:3b

# --- Outreach (default: dry_run) ---
SDR_OUTREACH_PROVIDER=dry_run
# Set to resend only after configuring a verified sender domain in Resend.
# SDR_OUTREACH_PROVIDER=resend
# SDR_OUTREACH_RESEND_API_KEY=
# SDR_OUTREACH_FROM_EMAIL=
# SDR_OUTREACH_SENDER_NAME=SDR Team
SDR_OUTREACH_SENDER_NAME=SDR Team
# SDR_OUTREACH_BREVO_API_KEY=
# SDR_OUTREACH_WEBHOOK_SECRET=

# --- Meeting (default: dry_run) ---
SDR_MEETING_PROVIDER=dry_run
# SDR_MEETING_GOOGLE_CLIENT_ID=
# SDR_MEETING_GOOGLE_CLIENT_SECRET=
# SDR_MEETING_GOOGLE_REFRESH_TOKEN=

# --- CRM (default: dry_run) ---
SDR_CRM_PROVIDER=dry_run
# SDR_CRM_TWENTY_API_KEY=

# --- Intelligence / MetaRank ---
# SDR_INTELLIGENCE_METARANK_URL=http://127.0.0.1:8081

# --- Conversation LLM ---
SDR_CONVERSATION_LLM_BASE_URL=http://127.0.0.1:11434
SDR_CONVERSATION_LLM_MODEL=llama3.1:8b
