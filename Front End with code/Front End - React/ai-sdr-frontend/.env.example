# AI SDR Frontend — optional overrides (copy to .env.local)
# Vite loads VITE_* at build/dev time.

# API base when not using the Vite proxy (default: /api → :8011)
# VITE_API_URL=/api

# Playwright E2E (defaults: port 5180)
# PLAYWRIGHT_PORT=5180
# PLAYWRIGHT_BASE_URL=http://localhost:5180

# Live E2E credentials (defaults match seeded admin)
# SDR_E2E_EMAIL=admin@sdr.local
# SDR_E2E_PASSWORD=admin123
